__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
*.egg-info/

# Data and derived artefacts are too large for version control.
data/*.pkl
data/results/*.pkl
logs/

# Analysis outputs are regenerated by analyses/run_all.sh, but the CSVs and
# logs are committed so that every number in the paper can be checked without
# running anything, and so that the scripts which do not train a decoder can
# be rerun from the cached decoder outputs. The large intermediate pickles are
# not committed; the scripts that write them rebuild them on first use.
analyses/results/*.pkl
